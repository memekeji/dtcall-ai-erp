# DTCall environment template
# Copy to .env and fill production secrets before deployment.

# Runtime
DEBUG=False
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,erp.dtcall.cn,www.dtcall.cn,dtcall.cn
CSRF_TRUSTED_ORIGINS=https://erp.dtcall.cn,https://www.dtcall.cn,https://dtcall.cn
X_FRAME_OPTIONS=DENY

# Server
APP_HOST=0.0.0.0
APP_PORT=8000
GUNICORN_WORKERS=4
AUTO_MIGRATE_ON_STARTUP=True
AUTO_START_PROJECT_RISK_REFRESH_SCHEDULER=True
PROJECT_RISK_REFRESH_HOUR=12
PROJECT_RISK_REFRESH_MINUTE=0
PROJECT_RISK_REFRESH_SLEEP_STEP=60

# Security
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Database
# Supported DATABASE_ENGINE values: sqlite, postgresql, postgres, pgsql, mysql, mariadb.
# DATABASE_URL is also supported, for example:
# postgresql://dtcall_user:password@127.0.0.1:5432/dtcall
# mysql://dtcall_user:password@127.0.0.1:3306/dtcall
DATABASE_URL=
DATABASE_ENGINE=postgresql
DATABASE_HOST=127.0.0.1
DATABASE_PORT=
DATABASE_NAME=dtcall
DATABASE_USER=dtcall_user
DATABASE_PASSWORD=
DATABASE_CONN_MAX_AGE=1800
DATABASE_CONN_HEALTH_CHECKS=True
DATABASE_CONNECT_TIMEOUT=10
MYSQL_CHARSET=utf8mb4

# Redis
# Leave REDIS_HOST empty to use Django local-memory cache.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# docker-compose local default
POSTGRES_PASSWORD=

# AI provider defaults
AI_PROVIDER=
AI_API_KEY=
AI_API_BASE=
AI_BASE_URL=
AI_CHAT_MODEL=
AI_EMBEDDING_MODEL=
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.7
AI_TOP_P=1.0

# Initial data helpers
INIT_ADMIN_PASSWORD=
